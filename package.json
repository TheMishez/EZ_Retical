{
  "name": "ez-reticle",
  "productName": "EZ Reticle",
  "version": "1.3.0",
  "description": "Custom crosshair overlay and designer for Windows",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "postinstall": "node tools/build-native.js",
    "build:native": "node tools/build-native.js"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.4",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": ">=33.2.0",
    "electron-builder": "^25.1.8",
    "node-gyp": "^11.0.0"
  },
  "build": {
    "appId": "com.ezggco.reticle",
    "productName": "EZ Reticle",
    "npmRebuild": false,
    "files": [
      "main.js",
      "preload.js",
      "crosshair.js",
      "overlay.html",
      "overlay.js",
      "editor.html",
      "editor.js",
      "editor.css",
      "sharecode.js",
      "pros.js",
      "package.json",
      "presets.js",
      "native/index.js",
      "native/build/Release/ez_native.node",
      "logo.png",
      "logo-64.png",
      "previews/**"
    ],
    "asarUnpack": [
      "native/build/Release/*.node"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "EZ Reticle",
      "createDesktopShortcut": true,
      "artifactName": "EZ-Reticle-Setup-${version}.exe"
    },
    "icon": "icon.png",
    "publish": [
      {
        "provider": "github",
        "owner": "TheMishez",
        "repo": "EZ_Retical",
        "releaseType": "release"
      }
    ]
  },
  "author": "EZGGco",
  "license": "MIT"
}
