{
  "name": "ez-reticle",
  "productName": "EZ Reticle",
  "version": "1.1.0",
  "description": "Custom crosshair overlay and designer for Windows",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": ">=33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ezggco.reticle",
    "productName": "EZ Reticle",
    "npmRebuild": false,
    "files": [
      "main.js",
      "preload.js",
      "crosshair.js",
      "overlay.html",
      "overlay.js",
      "editor.html",
      "editor.js",
      "editor.css",
      "sharecode.js",
      "pros.js",
      "package.json",
      "presets.js",
      "logo.png",
      "logo-64.png",
      "previews/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "EZ Reticle",
      "createDesktopShortcut": true,
      "artifactName": "EZ-Reticle-Setup-${version}.exe"
    },
    "icon": "icon.png"
  },
  "author": "EZGGco"
}
