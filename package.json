{
  "name": "mishez-xhair",
  "productName": "Mishez Xhair",
  "version": "1.0.0",
  "description": "Custom crosshair overlay and aim trainer for Windows",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.mishez.xhair",
    "productName": "Mishez Xhair",
    "npmRebuild": false,
    "files": [
      "main.js",
      "preload.js",
      "crosshair.js",
      "overlay.html",
      "overlay.js",
      "editor.html",
      "editor.js",
      "editor.css",
      "sharecode.js",
      "pros.js",
      "trainer.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
