<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app": signs the EZ Reticle program files before the installer is built. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="EZ Reticle.exe" />
      <include path="*.dll" min-matches="0" max-matches="unbounded" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
